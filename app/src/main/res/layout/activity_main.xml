<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- 构图辅助层：三分线 + 水平仪，之后的姿势虚线也画在这里 -->
    <com.qujingshi.aicamera.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- AI 美感分数与取景建议（NIMA），每 2 秒更新 -->
    <TextView
        android:id="@+id/txtAiScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="132dp"
        android:background="#40000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 变焦条：快捷倍率＋当前倍率显示；预览上双指捏合也能缩放 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="196dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/zoom1x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="#40000000"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="1×"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/zoom2x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="#40000000"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="2×"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/zoom3x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="#40000000"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="3×"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtZoomRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#40000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="1.0×"
            android:textColor="#FFC107"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnShutter"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_shutter"
        android:contentDescription="@string/btn_shutter" />

    <!-- 图库缩图：显示最新一张照片，点了直接开启 -->
    <ImageButton
        android:id="@+id/btnGallery"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="48dp"
        android:background="#33FFFFFF"
        android:contentDescription="@string/btn_gallery"
        android:scaleType="centerCrop" />

    <!-- AI 自动取景开关：开 = AI 自己变焦＋拍照自动裁成最好构图 -->
    <TextView
        android:id="@+id/btnAiFraming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:background="#40000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="@string/ai_framing_on"
        android:textSize="14sp" />

    <!-- 姿势引导切换：关 → 依序轮播内建姿势 -->
    <ImageButton
        android:id="@+id/btnPose"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:background="#40000000"
        android:contentDescription="@string/btn_pose"
        android:src="@drawable/ic_pose" />

    <!-- 引导模式切换：移镜头（虚线跟人）↔ 移人（虚线标出最佳位置） -->
    <ImageButton
        android:id="@+id/btnGuideMode"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="24dp"
        android:background="#40000000"
        android:contentDescription="@string/btn_guide_mode"
        android:src="@drawable/ic_guide_mode" />

    <TextView
        android:id="@+id/txtPoseName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="#40000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/btn_switch_camera"
        android:src="@drawable/ic_switch_camera" />

</FrameLayout>
